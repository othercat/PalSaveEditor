<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.6</Version>
    <Authors>othercat</Authors>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/othercat/PalSaveEditor</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GeshiEdition)' == 'true'">
    <DefineConstants>$(DefineConstants);GESHI_EDITION</DefineConstants>
    <BaseOutputPath>bin\Geshi\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\Geshi\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <Version>0.1.12</Version>
    <Product>SDLPal 存档编辑器（隔世／梦幻／梦时空）</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PalArtifactRoot)' != ''">
    <BaseOutputPath>$(PalArtifactRoot)/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(PalArtifactRoot)/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
